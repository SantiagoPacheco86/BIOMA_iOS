<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Plantilla de configuración privada de BIOMA.

  La app busca un archivo HelloWorld/Secrets.plist (junto a Info.plist) con
  esta misma estructura. La clave INaturalistAPIToken contiene el token que
  iNaturalist muestra en https://www.inaturalist.org/users/api_token a un
  usuario con sesión iniciada.

  HelloWorld/Secrets.plist está en .gitignore, por lo que nunca se sube al
  repositorio. El token caduca a las 24 horas; sin un token vigente, la
  Cámara guarda las fotos como «Especie no identificada».
-->
<plist version="1.0">
<dict>
	<key>INaturalistAPIToken</key>
	<string></string>
</dict>
</plist>
