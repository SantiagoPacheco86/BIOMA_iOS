<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Plantilla de configuración privada de BIOMA.

  1. Copia este archivo a HelloWorld/Secrets.plist (junto a Info.plist).
  2. Inicia sesión en iNaturalist y abre https://www.inaturalist.org/users/api_token
  3. Pega el valor de "api_token" en INaturalistAPIToken.

  HelloWorld/Secrets.plist está en .gitignore: nunca se sube al repositorio.
  El token caduca a las 24 horas; sin él, la Cámara guarda las fotos
  como «Especie no identificada».
-->
<plist version="1.0">
<dict>
	<key>INaturalistAPIToken</key>
	<string></string>
</dict>
</plist>
